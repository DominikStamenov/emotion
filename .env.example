# Shared public Supabase connection (safe for browser bundles)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
NEXT_PUBLIC_PORTAL_URL=https://portal.emotion.com

# Server-only integrations. Never prefix these with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_replace_me
RESEND_API_KEY=re_replace_me
CONTACT_FROM_EMAIL=eMotion <website@emotion.com>
CONTACT_NOTIFICATION_EMAIL=info@emotion.com
OPENAI_API_KEY=sk-replace_me
OPENAI_CHAT_MODEL=gpt-5.6-luna
IP_HASH_SECRET=replace-with-at-least-32-random-characters
