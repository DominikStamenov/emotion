# Shared public Supabase connection (safe for browser bundles)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
NEXT_PUBLIC_SITE_URL=https://your-web-project.vercel.app
NEXT_PUBLIC_ADMIN_URL=https://your-admin-project.vercel.app
NEXT_PUBLIC_PORTAL_URL=https://your-portal-project.vercel.app
# Leave empty until a real public contact address is confirmed.
NEXT_PUBLIC_CONTACT_EMAIL=

# Server-only integrations. Never prefix these with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_replace_me
# Leave email integration unset until a sending domain is verified.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
CONTACT_NOTIFICATION_EMAIL=
OPENAI_API_KEY=sk-replace_me
OPENAI_CHAT_MODEL=gpt-5.6-luna
IP_HASH_SECRET=replace-with-at-least-32-random-characters
